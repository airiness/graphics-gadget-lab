{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gglab.nonfinite-watch",
  "title": "GGLab submitted non-finite coverage v2",
  "type": "object",
  "required": ["schema", "schemaVersion", "configurationVersion", "mode", "coverage", "instrumentation", "claims", "firstFrameSerial", "lastFrameSerial", "frames", "completedFrames", "complete", "boundary", "production", "failure", "firstAnomalyFrameSerial", "reason", "injection"],
  "properties": {
    "schema": {"const": "gglab.nonfinite-watch"},
    "schemaVersion": {"const": 2},
    "configurationVersion": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["report", "fail"]},
    "coverage": {"const": "submitted-range"},
    "instrumentation": {"enum": ["available", "unavailable"]},
    "claims": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["boundary", "production"]}},
    "firstFrameSerial": {"type": "integer", "minimum": 0},
    "lastFrameSerial": {"type": "integer", "minimum": 0},
    "frames": {"type": "integer", "minimum": 0},
    "completedFrames": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "boundary": {"$ref": "#/$defs/claim"},
    "production": {"$ref": "#/$defs/claim"},
    "failure": {"type": "string"},
    "firstAnomalyFrameSerial": {"type": ["integer", "null"], "minimum": 1},
    "reason": {"enum": ["None", "NonFiniteDetected", "NonFiniteReplaced", "ClampPolicyExceeded", "MissingCoverage"]},
    "injection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/injection"}]}
  },
  "$defs": {
    "claim": {"enum": ["Unavailable", "Incomplete", "NotApplicable", "Passed", "Failed"]},
    "injection": {
      "type": "object",
      "required": ["point", "value", "x", "y", "component", "injectedFrames", "appliedFrames"],
      "properties": {
        "point": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "value": {"enum": ["NaN", "PositiveInfinity", "NegativeInfinity", "Overflow", "Negative"]},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "component": {"type": "integer", "minimum": 0, "maximum": 3},
        "injectedFrames": {"type": "integer", "minimum": 0},
        "appliedFrames": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
