{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gglab.capture-bundle",
  "title": "GGLab same-frame and sequence-range capture bundles v1 through v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "bundleId", "runIdentity", "consistency", "watch", "products"],
  "properties": {
    "schema": {"const": "gglab.capture-bundle"},
    "schemaVersion": {"enum": [1, 2, 3]},
    "bundleId": {"type": "string", "pattern": "^[0-9a-f]{32}-(j[1-9][0-9]*-a[1-9][0-9]*|s[1-9][0-9]*-(timing|range))$"},
    "runIdentity": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "jobId": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "consistency": {"enum": ["same-frame", "sequence-range"]},
    "sequence": {"$ref": "#/$defs/sequenceRange"},
    "environment": {"$ref": "#/$defs/environment"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "content", "sceneInputs", "frame", "camera", "time", "developmentTools", "readiness", "temporal", "sequence"],
      "properties": {
        "backend": {"enum": ["dx12", "vulkan"]},
        "content": {"type": "object"},
        "sceneInputs": {"type": ["object", "null"]},
        "frame": {
          "type": "object", "required": ["serial", "index"],
          "properties": {"serial": {"type": "integer", "minimum": 1}, "index": {"type": "integer", "minimum": 0}}
        },
        "camera": {"type": "object"},
        "time": {"type": "object"},
        "developmentTools": {"type": "boolean"},
        "readiness": {"type": "object"},
        "temporal": {"type": "object"},
        "sequence": {"type": ["object", "null"]},
        "parameters": {"type": ["object", "null"]},
        "control": {"$ref": "#/$defs/control"}
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["fenceIndex", "fenceGeneration", "fenceValue", "adapterDriverIdentity"],
      "properties": {
        "fenceIndex": {"type": "integer", "minimum": 0},
        "fenceGeneration": {"type": "integer", "minimum": 0},
        "fenceValue": {"type": "integer", "minimum": 1},
        "adapterDriverIdentity": {"type": "string"}
      }
    },
    "watch": {"type": ["object", "null"]},
    "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/product"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}},
      "then": {"not": {"required": ["environment"]}},
      "else": {"required": ["environment"]}
    },
    {
      "if": {
        "properties": {
          "consistency": {
            "const": "same-frame"
          }
        }
      },
      "then": {
        "required": [
          "jobId",
          "attempt",
          "provenance",
          "submission"
        ],
        "not": {
          "required": [
            "sequence"
          ]
        },
        "properties": {
          "bundleId": {
            "pattern": "^[0-9a-f]{32}-j[1-9][0-9]*-a[1-9][0-9]*$"
          },
          "products": {
            "items": {
              "properties": {
                "source": {
                  "enum": [
                    "scene",
                    "composited",
                    "diagnostic",
                    "graph",
                    "resource-export"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "schemaVersion": {
              "const": 2
            }
          }
        },
        "then": {
          "required": [
            "sequence",
            "environment"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "bundleId": {
              "pattern": "^[0-9a-f]{32}-s[1-9][0-9]*-timing$"
            },
            "products": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "index": {
                    "const": 0
                  },
                  "source": {
                    "const": "gpu-timing"
                  },
                  "diagnosticTap": {
                    "type": "null"
                  },
                  "schema": {
                    "const": "gglab.gpu-timing"
                  },
                  "schemaVersion": {
                    "const": 1
                  }
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "jobId"
                ]
              },
              {
                "required": [
                  "attempt"
                ]
              },
              {
                "required": [
                  "provenance"
                ]
              },
              {
                "required": [
                  "submission"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "sequence",
            "environment"
          ],
          "properties": {
            "schemaVersion": {
              "const": 3
            },
            "bundleId": {
              "pattern": "^[0-9a-f]{32}-s[1-9][0-9]*-(timing|range)$"
            },
            "products": {
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "properties": {
                  "source": {
                    "enum": [
                      "gpu-timing",
                      "parameter-frames"
                    ]
                  },
                  "diagnosticTap": {
                    "type": "null"
                  },
                  "schema": {
                    "enum": [
                      "gglab.gpu-timing",
                      "gglab.parameter-frames"
                    ]
                  },
                  "schemaVersion": {
                    "const": 1
                  }
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "jobId"
                ]
              },
              {
                "required": [
                  "attempt"
                ]
              },
              {
                "required": [
                  "provenance"
                ]
              },
              {
                "required": [
                  "submission"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          },
          "consistency": {
            "const": "same-frame"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "parameters"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sequenceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "pathVersion",
        "frameCount",
        "referenceSamples",
        "firstFrameSerial",
        "lastFrameSerial"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pathVersion": {
          "type": "integer",
          "minimum": 1
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1
        },
        "referenceSamples": {
          "type": "integer",
          "minimum": 0
        },
        "firstFrameSerial": {
          "type": "integer",
          "minimum": 1
        },
        "lastFrameSerial": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:]+$"},
    "text": {"type": ["string", "null"], "minLength": 1},
    "validationLevel": {"enum": ["off", "standard", "gpu", null]},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "build", "process", "device", "validation"],
      "properties": {
        "schemaVersion": {"const": 1},
        "build": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "revision", "dirty", "configuration", "compiler", "pixIntegration"],
          "properties": {
            "source": {"enum": ["build-stamp", "unavailable"]},
            "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "dirty": {"type": ["boolean", "null"]},
            "configuration": {"$ref": "#/$defs/text"},
            "compiler": {"$ref": "#/$defs/text"},
            "pixIntegration": {"type": ["boolean", "null"]}
          },
          "if": {"properties": {"source": {"const": "unavailable"}}},
          "then": {"properties": {"revision": {"const": null}, "dirty": {"const": null}}},
          "else": {"properties": {"revision": {"type": "string"}}}
        },
        "process": {
          "type": "object", "additionalProperties": false,
          "required": ["runIdentity", "startedAtUtc", "os", "host"],
          "properties": {
            "runIdentity": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
            "startedAtUtc": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
            "os": {"$ref": "#/$defs/text"},
            "host": {"$ref": "#/$defs/text"}
          }
        },
        "device": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["backend", "adapterName", "vendorId", "deviceId", "subsystemId", "revision", "driverVersion", "driverVersionRaw", "api", "dedicatedVideoMemoryBytes", "compatibilityIdentity"],
              "properties": {
                "backend": {"enum": ["dx12", "vulkan"]},
                "adapterName": {"type": "string"},
                "vendorId": {"type": "integer", "minimum": 0},
                "deviceId": {"type": "integer", "minimum": 0},
                "subsystemId": {"type": ["integer", "null"], "minimum": 0},
                "revision": {"type": ["integer", "null"], "minimum": 0},
                "driverVersion": {"$ref": "#/$defs/text"},
                "driverVersionRaw": {"$ref": "#/$defs/text"},
                "api": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "featureLevel": {"type": "string", "pattern": "^[0-9]+_[0-9]+$"},
                    "shaderModel": {"type": "string", "pattern": "^[0-9]+_[0-9]+$"},
                    "apiVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
                  }
                },
                "dedicatedVideoMemoryBytes": {"type": ["integer", "null"], "minimum": 0},
                "compatibilityIdentity": {"type": "string"}
              }
            }
          ]
        },
        "validation": {
          "type": "object", "additionalProperties": false,
          "required": ["requested", "effective"],
          "properties": {
            "requested": {"$ref": "#/$defs/validationLevel"},
            "effective": {"$ref": "#/$defs/validationLevel"}
          }
        }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "source", "diagnosticTap", "schema", "schemaVersion", "metadata", "files"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "source": {"enum": ["scene", "composited", "diagnostic", "graph", "resource-export", "gpu-timing", "parameter-frames"]},
        "diagnosticTap": {"type": ["string", "null"], "minLength": 1},
        "schema": {"enum": ["gglab.frame-capture", "gglab.render-graph", "gglab.resource-export", "gglab.gpu-timing", "gglab.parameter-frames"]},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "metadata": {"$ref": "#/$defs/file"},
        "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "runIdentityOrNull": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
    "parameterValue": {"type": ["boolean", "integer", "number", "array"]},
    "parameterType": {"enum": ["bool", "int", "uint", "float", "enum", "vector3", "color"]},
    "valueSource": {"enum": ["content", "tooling", "camera", "host", "sequence", "forced-reference"]},
    "control": {
      "description": "Host view control evidence of the issued frame; absent in earlier bundles, which carry no such proof.",
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["schemaVersion", "hostViewControl", "hostView", "requiredFrameState"],
      "properties": {
        "schemaVersion": {"const": 1},
        "hostViewControl": {
          "type": "object", "additionalProperties": false,
          "required": ["runIdentity", "contentIdentity", "hostViewRevision"],
          "properties": {
            "runIdentity": {"$ref": "#/$defs/runIdentityOrNull"},
            "contentIdentity": {"type": "integer", "minimum": 0},
            "hostViewRevision": {"type": "integer", "minimum": 0}
          }
        },
        "hostView": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "value", "source", "inheritedSource", "hostOverride"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"$ref": "#/$defs/parameterType"},
              "value": {"$ref": "#/$defs/parameterValue"},
              "source": {"$ref": "#/$defs/valueSource"},
              "inheritedSource": {"enum": ["content", "tooling", "camera"]},
              "hostOverride": {
                "type": "object", "additionalProperties": false, "required": ["present"],
                "properties": {"present": {"type": "boolean"}, "value": {"$ref": "#/$defs/parameterValue"}},
                "if": {"properties": {"present": {"const": true}}},
                "then": {"required": ["value"]},
                "else": {"not": {"required": ["value"]}}
              }
            }
          }
        },
        "requiredFrameState": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["runIdentity", "contentIdentity", "minHostViewRevision", "values", "temporalConsumers", "referenceSampling"],
          "properties": {
            "runIdentity": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "contentIdentity": {"type": "integer", "minimum": 0},
            "minHostViewRevision": {"type": "integer", "minimum": 0},
            "values": {
              "type": "array", "minItems": 1, "maxItems": 128,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "type", "value", "source"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "type": {"$ref": "#/$defs/parameterType"},
                  "value": {"$ref": "#/$defs/parameterValue"},
                  "source": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/valueSource"}]}
                }
              }
            },
            "temporalConsumers": {
              "type": "array", "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["consumer", "status", "disableReason"],
                "properties": {
                  "consumer": {"enum": ["temporal-aa", "reference", "temporal-gtao"]},
                  "status": {"enum": ["disabled", "unavailable", "active"]},
                  "disableReason": {"type": ["string", "null"], "minLength": 1}
                }
              }
            },
            "referenceSampling": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
