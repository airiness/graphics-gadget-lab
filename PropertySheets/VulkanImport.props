<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Vulkan SDK integration for the Vulkan RHI backend.

    Contract:
      - GGLAB_ENABLE_VULKAN defaults to 1 (official developer/CI); set to 0
        to build a DX12-only executable without Vulkan SDK headers or libs.
      - The pinned Vulkan SDK (1.3.296) is discovered through the VULKAN_SDK
        environment variable. A missing or mismatched SDK is a build error;
        it is never silently replaced by another SDK.
      - vulkan-1.lib is linked from the SDK; the runtime uses the system
        Vulkan loader, which is not copied into the output directory.
  -->
  <PropertyGroup>
    <GGLAB_ENABLE_VULKAN Condition="'$(GGLAB_ENABLE_VULKAN)'==''">1</GGLAB_ENABLE_VULKAN>
  </PropertyGroup>
  <ItemGroup Condition="'$(GGLAB_ENABLE_VULKAN)'!='0'">
    <VulkanSdkRoot Include="$(VULKAN_SDK)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(GGLAB_ENABLE_VULKAN)'!='0'">
    <GGLabVulkanSdkRoot Condition="'$(GGLAB_VULKAN_SDK_ROOT)'!=''">$(GGLAB_VULKAN_SDK_ROOT)</GGLabVulkanSdkRoot>
    <GGLabVulkanSdkRoot Condition="'$(GGLabVulkanSdkRoot)'==''">$(VULKAN_SDK)</GGLabVulkanSdkRoot>
    <GGLabVulkanSdkPinnedVersion>1.3.296</GGLabVulkanSdkPinnedVersion>
    <GGLabVulkanSdkRootTrimmed>$([System.String]::new('$(GGLabVulkanSdkRoot)').TrimEnd('\'))</GGLabVulkanSdkRootTrimmed>
    <GGLabVulkanSdkVersion>$([System.IO.Path]::GetFileName('$(GGLabVulkanSdkRootTrimmed)'))</GGLabVulkanSdkVersion>
  </PropertyGroup>
  <Target Name="GGLabValidateVulkanSdk" BeforeTargets="ClCompile" Condition="'$(GGLAB_ENABLE_VULKAN)'!='0'">
    <Error Condition="'$(GGLabVulkanSdkRoot)'==''"
           Text="GGLAB_ENABLE_VULKAN=1 requires the Vulkan SDK. Set the VULKAN_SDK environment variable to the pinned SDK root (1.3.296), or set GGLAB_ENABLE_VULKAN=0 for a DX12-only build." />
    <Error Condition="!Exists('$(GGLabVulkanSdkRoot)\Include\vulkan\vulkan.h')"
           Text="Vulkan SDK include not found at '$(GGLabVulkanSdkRoot)'. The pinned SDK root must contain Include\vulkan\vulkan.h. Set GGLAB_VULKAN_SDK_ROOT or VULKAN_SDK to the pinned SDK, or set GGLAB_ENABLE_VULKAN=0." />
    <Error Condition="!Exists('$(GGLabVulkanSdkRoot)\Lib\vulkan-1.lib')"
           Text="Vulkan SDK library vulkan-1.lib not found at '$(GGLabVulkanSdkRoot)'. Set GGLAB_VULKAN_SDK_ROOT or VULKAN_SDK to the pinned SDK, or set GGLAB_ENABLE_VULKAN=0." />
    <Error Condition="'$(GGLabVulkanSdkVersion)' != '1.3.296' and !$(GGLabVulkanSdkVersion.StartsWith('1.3.296.'))"
           Text="Expected Vulkan SDK 1.3.296, but '$(GGLabVulkanSdkRoot)' reports version '$(GGLabVulkanSdkVersion)'. Set VULKAN_SDK or GGLAB_VULKAN_SDK_ROOT to the pinned 1.3.296 SDK, or set GGLAB_ENABLE_VULKAN=0 for a DX12-only build." />
    <Message Importance="High" Text="GGLab Vulkan backend enabled with SDK root '$(GGLabVulkanSdkRoot)' (version $(GGLabVulkanSdkVersion), pinned $(GGLabVulkanSdkPinnedVersion))." />
  </Target>
  <ItemDefinitionGroup Condition="'$(GGLAB_ENABLE_VULKAN)'!='0'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(GGLabVulkanSdkRoot)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GGLAB_ENABLE_VULKAN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(GGLabVulkanSdkRoot)\Lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>vulkan-1.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(GGLAB_ENABLE_VULKAN)'=='0'">
    <ClCompile>
      <PreprocessorDefinitions>GGLAB_ENABLE_VULKAN=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
