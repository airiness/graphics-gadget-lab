<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GGLAB_ARTIFACT_ONLY_RUNTIME Condition="'$(GGLAB_ARTIFACT_ONLY_RUNTIME)'==''">0</GGLAB_ARTIFACT_ONLY_RUNTIME>
    <GGLAB_USE_PCH Condition="'$(GGLAB_USE_PCH)'==''">1</GGLAB_USE_PCH>
    <GGLabArtifactOnlyDefine Condition="'$(GGLAB_ARTIFACT_ONLY_RUNTIME)'=='1'">GGLAB_ARTIFACT_ONLY_RUNTIME=1;</GGLabArtifactOnlyDefine>
    <GGLabHostBuildRoot>$(GGLabRepositoryRoot)Build\</GGLabHostBuildRoot>
    <GGLabHostBuildRoot Condition="'$(GGLAB_ARTIFACT_ONLY_RUNTIME)'=='1'">$(GGLabRepositoryRoot)Build\ArtifactOnly\</GGLabHostBuildRoot>
    <OutDir>$(GGLabHostBuildRoot)Output\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(GGLabHostBuildRoot)Intermediate\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <IntDir Condition="'$(GGLAB_USE_PCH)'=='0'">$(GGLabHostBuildRoot)Intermediate\$(ProjectName)\$(Platform)\$(Configuration)\NoPCH\</IntDir>
  </PropertyGroup>
</Project>
