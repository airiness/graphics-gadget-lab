<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Writes the build's declaration of the tracked source state it is built from: the Git
    revision, whether tracked files differ from it, and the configuration. The header is
    rewritten only when its content changes, so an unchanged tree recompiles nothing. Without
    Git the stamp reports the source state as unavailable and the build continues. The stamp
    is not a binary identity and records no build time or machine path.
  -->
  <PropertyGroup>
    <GGLabBuildStampHeader>$(IntDir)GGLabBuildStamp.g.h</GGLabBuildStampHeader>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="GGLabWriteBuildStamp" BeforeTargets="ClCompile">
    <!-- The trailing "." keeps the quoted directory from ending in a backslash. -->
    <Exec Command="git -C &quot;$(GGLabRepositoryRoot).&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GGLabStampRevision" />
      <Output TaskParameter="ExitCode" PropertyName="_GGLabStampRevisionExit" />
    </Exec>
    <Exec Command="git -C &quot;$(GGLabRepositoryRoot).&quot; --no-optional-locks status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GGLabStampStatusLine" />
      <Output TaskParameter="ExitCode" PropertyName="_GGLabStampStatusExit" />
    </Exec>

    <PropertyGroup>
      <_GGLabStampRevision>$(_GGLabStampRevision.Trim())</_GGLabStampRevision>
      <_GGLabStampAvailable>0</_GGLabStampAvailable>
      <_GGLabStampAvailable Condition="'$(_GGLabStampRevisionExit)'=='0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GGLabStampRevision)', '^[0-9a-f]{40}$'))">1</_GGLabStampAvailable>
      <_GGLabStampRevisionText></_GGLabStampRevisionText>
      <_GGLabStampRevisionText Condition="'$(_GGLabStampAvailable)'=='1'">$(_GGLabStampRevision)</_GGLabStampRevisionText>
      <!-- -1 unknown, 0 clean, 1 tracked files differ from the revision. -->
      <_GGLabStampDirty>-1</_GGLabStampDirty>
      <_GGLabStampDirty Condition="'$(_GGLabStampAvailable)'=='1' and '$(_GGLabStampStatusExit)'=='0' and '@(_GGLabStampStatusLine)'==''">0</_GGLabStampDirty>
      <_GGLabStampDirty Condition="'$(_GGLabStampAvailable)'=='1' and '$(_GGLabStampStatusExit)'=='0' and '@(_GGLabStampStatusLine)'!=''">1</_GGLabStampDirty>
    </PropertyGroup>

    <ItemGroup>
      <_GGLabStampLine Include="// Generated by PropertySheets/GGLabBuildStamp.targets%3B do not edit." />
      <_GGLabStampLine Include="#pragma once" />
      <_GGLabStampLine Include="#define GGLAB_BUILD_STAMP_AVAILABLE $(_GGLabStampAvailable)" />
      <_GGLabStampLine Include="#define GGLAB_BUILD_STAMP_REVISION &quot;$(_GGLabStampRevisionText)&quot;" />
      <_GGLabStampLine Include="#define GGLAB_BUILD_STAMP_DIRTY $(_GGLabStampDirty)" />
      <_GGLabStampLine Include="#define GGLAB_BUILD_STAMP_CONFIGURATION &quot;$(Configuration)&quot;" />
    </ItemGroup>

    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(GGLabBuildStampHeader)"
                      Lines="@(_GGLabStampLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(GGLabBuildStampHeader)" />
    </ItemGroup>
  </Target>
</Project>
