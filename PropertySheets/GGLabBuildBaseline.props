<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Workspace-wide C++ build baseline.

    Adoption: every first-party project except NapaVoxelCore -
      GGLabFoundation, GGLabFoundationTests, GGLabTestCore and
      NapaVoxelCoreTests import this sheet directly; Application,
      GGLabRuntime and GGLabRuntimeTests get it through Common.props.
      NapaVoxelCore is a deliberate exception: it keeps an independent build
      identity rooted at $(NapaVoxelRepositoryRoot) with a host-independent/
      UBT posture and must not consume workspace-wide build policy.

    Contract: only the policy every adopter actually shares:
      - repository root and the OutDir/IntDir layout;
      - the pinned C++20 language standard;
      - conformance mode and SDLCheck;
      - a numeric development-build switch for Debug and Develop;
      - optimized Develop compilation with release CRT and debug symbols.

    Windows platform macros, external include roots, /MP and warning levels are
    deliberately NOT here: they are not universal across adopters.
    Common.props layers the Windows/runtime environment on top of this
    baseline.
  -->
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <GGLabRepositoryRoot Condition="'$(GGLabRepositoryRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</GGLabRepositoryRoot>
    <OutDir>$(GGLabRepositoryRoot)Build\Output\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(GGLabRepositoryRoot)Build\Intermediate\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <GGLabDevelopmentBuild>0</GGLabDevelopmentBuild>
    <GGLabDevelopmentBuild Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Develop'">1</GGLabDevelopmentBuild>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>GGLAB_DEVELOPMENT_BUILD=$(GGLabDevelopmentBuild);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Develop'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SupportJustMyCode>false</SupportJustMyCode>
      <FloatingPointModel>Precise</FloatingPointModel>
      <PreprocessorDefinitions>BUILD_DEVELOP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/Zo %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <OptimizeReferences>false</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>
