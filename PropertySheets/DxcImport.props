<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    DXC (DirectX Shader Compiler) NuGet integration, props half.

    Contract:
      - The pinned DXC NuGet package (Microsoft.Direct3D.DXC 1.9.2607.13) is
        the single source for DXC headers, dxcompiler.lib and the runtime DLL
        copy items. Consumers import this sheet in their PropertySheets group
        (NuGet props-early convention) and import DxcImport.targets in their
        ExtensionTargets group (NuGet targets-late convention).
      - The phase split is load-bearing: the package .targets adds the DXC
        include directory through an ItemDefinitionGroup, and the D3D12
        package ships a competing d3d12shader.h in its own include directory.
        Keeping the DXC .targets import at the end of ExtensionTargets (after
        the D3D12 .targets) makes the DXC include directory win; importing it
        from this sheet instead would resolve it before the D3D12 .targets
        and silently flip d3d12shader.h to the D3D12 package copy.
      - A missing package restore is a build error; it is never silently
        skipped.
  -->
  <PropertyGroup>
    <GGLabDxcPackageVersion>1.9.2607.13</GGLabDxcPackageVersion>
    <GGLabDxcPackageRoot>$(GGLabRepositoryRoot)packages\Microsoft.Direct3D.DXC.$(GGLabDxcPackageVersion)\build\native</GGLabDxcPackageRoot>
  </PropertyGroup>
  <Import Project="$(GGLabDxcPackageRoot)\Microsoft.Direct3D.DXC.props" Condition="Exists('$(GGLabDxcPackageRoot)\Microsoft.Direct3D.DXC.props')" />
  <Target Name="GGLabEnsureDxcPackage" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GGLabDxcPackageRoot)\Microsoft.Direct3D.DXC.props')"
           Text="The pinned DXC NuGet package is missing: '$(GGLabDxcPackageRoot)'. Restore packages through Visual Studio/NuGet before building." />
    <Error Condition="!Exists('$(GGLabDxcPackageRoot)\Microsoft.Direct3D.DXC.targets')"
           Text="The pinned DXC NuGet package is missing: '$(GGLabDxcPackageRoot)'. Restore packages through Visual Studio/NuGet before building." />
  </Target>
  <ItemGroup />
</Project>
