<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CmdExe>$(ComSpec)</CmdExe>
    <CmdExe Condition="'$(CmdExe)'==''">$(SystemRoot)\System32\cmd.exe</CmdExe>
  </PropertyGroup>

  <Target Name="LinkShadersIntoOutDir"
          BeforeTargets="PrepareForBuild"
          Condition="'$(OS)'=='Windows_NT' and '$(_IsAppProject)'=='true' and Exists('$(ShaderSrcDir)')">
    <MakeDir Directories="$(OutDir)" />
    <!-- Multiple application targets share OutDir. Keep an existing junction so
         another target cannot remove it between creation and validation. A
         losing mklink process may still report failure after another target
         created the same junction, so validate the final filesystem state. -->
    <Exec Command="&quot;$(CmdExe)&quot; /D /C if not exist &quot;$(ShaderOutDir)&quot; mklink /J &quot;$(ShaderOutDir)&quot; &quot;$(ShaderSrcDir)&quot;"
          IgnoreExitCode="true" />
    <Error Condition="!Exists('$(ShaderOutDir)')"
           Text="Failed to link shader directory '$(ShaderOutDir)' to '$(ShaderSrcDir)'." />
  </Target>

  <Target Name="UnlinkShadersFromOutDir"
          AfterTargets="Clean"
          Condition="'$(OS)'=='Windows_NT' and '$(_IsAppProject)'=='true'">
    <Exec Command="&quot;$(CmdExe)&quot; /D /C if exist &quot;$(ShaderOutDir)&quot; rmdir &quot;$(ShaderOutDir)&quot;"
          IgnoreExitCode="true" />
  </Target>
</Project>
